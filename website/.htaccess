# intellipresta.com — response headers.
#
# Closes the findings raised by the OWASP ZAP baseline scan of 1 September
# 2026 against the public site: no Content-Security-Policy, no
# anti-clickjacking header, no Permissions-Policy, no cross-origin policies,
# and the PHP version advertised in X-Powered-By.
#
# The policy deliberately allows the Crisp chat widget. A policy that closed
# the finding by breaking live support would be a worse outcome than the
# finding; the allowances below are exactly Crisp's documented origins and
# nothing wider.
#
# See docs/security/vulnerability-management.md in the module repository.

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://client.crisp.chat; style-src 'self' 'unsafe-inline' https://client.crisp.chat; font-src 'self' https://client.crisp.chat; img-src 'self' data: https://client.crisp.chat https://image.crisp.chat; connect-src 'self' https://client.crisp.chat wss://client.relay.crisp.chat; media-src https://client.crisp.chat; frame-src https://client.crisp.chat"

    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()"

    # Cross-Origin-Embedder-Policy is deliberately NOT set to require-corp:
    # it would block the Crisp widget. The other two are safe here.
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"

    Header always unset X-Powered-By
</IfModule>

<IfModule mod_php.c>
    php_flag expose_php off
</IfModule>

# No directory listings anywhere on the site.
Options -Indexes

# TRACK is refused, and TRACE would be if this could refuse it.
#
# Leaving these on permits Cross-Site Tracing: the request is echoed back
# complete with headers, which is a way to read a cookie that script cannot.
# Found by the penetration test of 1 September 2026.
#
# The answer depends on the server, and both halves were verified rather
# than assumed:
#
#   Apache  - the rule stops TRACK but NOT TRACE, because Apache handles
#             that method in core before mod_rewrite runs. TRACK returned
#             405 and TRACE still returned 200 after this was added.
#             Refusing it there needs TraceEnable Off in the server
#             configuration, which .htaccess may not set.
#   LiteSpeed - the rule stops both. Production answered TRACE 200 before
#             this file was uploaded on 2 September 2026 and 405 after.
#
# Production runs LiteSpeed, so TRACE is refused there outright. It was
# not exploitable beforehand either - LiteSpeed returned the page rather
# than echoing the request - but a method that is not implemented should
# answer 405, not 200.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK)
    RewriteRule .* - [R=405,L]
</IfModule>
